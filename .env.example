# Server-only. Generate a unique random secret of at least 32 bytes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full
BETTER_AUTH_URL=https://growora.example
BETTER_AUTH_SECRET=
SMTP_HOST=smtp.example
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Growora <accounts@growora.example>
# Optional. Set only behind an ingress that overwrites this header and blocks direct access.
AUTH_CLIENT_IP_HEADER=

# Existing account IDs authorized to configure the MAIN website (comma-separated).
# Each must also own the selected workspace. Blank disables configuration.
MARKETING_WEBSITE_OWNER_IDS=

# AI is disabled until credentials, model and a reviewed per-workspace processing policy exist.
# The policy reference must document lawful basis, notice/consent, provider terms and retention.
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=
AI_PROCESSING_POLICY=
AI_APPROVED_WORKSPACE_IDS=
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_ATTEMPTS=3
AI_CONCURRENCY=2
AI_DAILY_REQUEST_LIMIT=100
# Optional model-specific published rates; leave blank to display unknown cost.
AI_INPUT_USD_PER_MILLION=
AI_OUTPUT_USD_PER_MILLION=
