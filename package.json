{
  "name": "growora",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests",
    "test": "node --experimental-strip-types --test tests/domain.test.ts tests/body.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "test:auth": "node --test tests/auth.integration.mjs",
    "test:ai": "node --experimental-strip-types --test tests/intelligence.test.ts tests/intelligence.integration.ts",
    "ai:worker": "node --experimental-strip-types scripts/ai-worker.ts",
    "ai:evaluate": "node --experimental-strip-types scripts/ai-evaluate.ts",
    "routing:worker": "node --experimental-strip-types scripts/routing-worker.ts",
    "test:routing": "node --experimental-strip-types --test tests/routing.test.ts tests/routing.integration.ts"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
    "smtp-server": "^3.21.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
